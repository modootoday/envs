{
  "name": "instana/agent",
  "version": 1,
  "title": "IBM Instana — agent",
  "keys": {
    "INSTANA_AGENT_KEY": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://www.ibm.com/products/instana",
      "description": "Agent key."
    },
    "INSTANA_ENDPOINT_URL": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^https://\\S+$",
      "obtain": "https://www.ibm.com/products/instana",
      "description": "Backend endpoint. An address."
    }
  }
}
