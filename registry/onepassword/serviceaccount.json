{
  "name": "onepassword/serviceaccount",
  "version": 1,
  "title": "1Password — service account",
  "keys": {
    "OP_SERVICE_ACCOUNT_TOKEN": {
      "required": true,
      "sensitivity": "secret",
      "pattern": "^ops_[A-Za-z0-9._-]{20,}$",
      "obtain": "https://developer.1password.com/docs/service-accounts/",
      "description": "Service account token for the CLI and SDKs."
    }
  }
}
