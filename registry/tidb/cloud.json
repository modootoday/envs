{
  "name": "tidb/cloud",
  "version": 1,
  "title": "TiDB Cloud — serverless cluster",
  "keys": {
    "TIDB_DATABASE_URL": {
      "required": true,
      "sensitivity": "secret",
      "pattern": "^mysql://\\S+$",
      "obtain": "https://tidbcloud.com/",
      "description": "MySQL-protocol connection string including the password."
    }
  }
}
