{
  "name": "hanko/auth",
  "version": 1,
  "title": "Hanko — passkey auth",
  "keys": {
    "HANKO_API_URL": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^https://\\S+$",
      "obtain": "https://cloud.hanko.io/",
      "description": "API address the browser element talks to."
    },
    "HANKO_API_KEY": {
      "required": false,
      "sensitivity": "secret",
      "obtain": "https://cloud.hanko.io/",
      "description": "Admin API key. Server-side only."
    }
  }
}
