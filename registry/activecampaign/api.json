{
  "name": "activecampaign/api",
  "version": 1,
  "title": "ActiveCampaign — API",
  "keys": {
    "ACTIVECAMPAIGN_API_URL": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^https://\\S+$",
