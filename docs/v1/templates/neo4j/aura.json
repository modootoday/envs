{
  "name": "neo4j/aura",
  "version": 1,
  "title": "Neo4j Aura — graph database",
  "keys": {
    "NEO4J_URI": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^(neo4j|bolt)\\+?s?://\\S+$",
      "obtain": "https://console.neo4j.io/",
      "description": "Instance address. The password below is the credential."
    },
    "NEO4J_USERNAME": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://console.neo4j.io/",
      "description": "Database user, usually neo4j."
    },
    "NEO4J_PASSWORD": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://console.neo4j.io/",
      "description": "Password shown once when the instance is created."
    }
  }
}
