{
  "name": "clickhouse/cloud",
  "version": 1,
  "title": "ClickHouse Cloud — service",
  "keys": {
    "CLICKHOUSE_URL": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^https://\\S+$",
      "obtain": "https://clickhouse.cloud/",
      "description": "Service endpoint. An address; the password below is the credential."
    },
    "CLICKHOUSE_USER": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://clickhouse.cloud/",
      "description": "Database user. Half of a credential pair, so it stays off the browser side with the password."
    },
    "CLICKHOUSE_PASSWORD": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://clickhouse.cloud/",
      "description": "Password for that user."
    }
  }
}
