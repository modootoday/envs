{
  "name": "magic/auth",
  "version": 1,
  "title": "Magic — passwordless auth",
  "keys": {
    "MAGIC_PUBLISHABLE_KEY": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^pk_live_[A-Za-z0-9]{10,}$",
      "obtain": "https://dashboard.magic.link/",
      "description": "Publishable key for the browser SDK."
    },
    "MAGIC_SECRET_KEY": {
      "required": true,
      "sensitivity": "secret",
      "pattern": "^sk_live_[A-Za-z0-9]{10,}$",
      "obtain": "https://dashboard.magic.link/",
      "description": "Server-side key that validates tokens."
    }
  }
}
