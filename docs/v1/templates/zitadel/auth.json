{
  "name": "zitadel/auth",
  "version": 1,
  "title": "ZITADEL — authentication",
  "keys": {
    "ZITADEL_ISSUER": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^https://\\S+$",
      "obtain": "https://zitadel.com/",
      "description": "Issuer address, published in the OIDC discovery document."
    },
    "ZITADEL_CLIENT_ID": {
      "required": true,
      "sensitivity": "config",
      "obtain": "https://zitadel.com/",
      "description": "Client id for the OIDC flow."
    },
    "ZITADEL_CLIENT_SECRET": {
      "required": false,
      "sensitivity": "secret",
      "obtain": "https://zitadel.com/",
      "description": "Only for confidential clients."
    }
  }
}
