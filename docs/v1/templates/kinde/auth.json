{
  "name": "kinde/auth",
  "version": 1,
  "title": "Kinde — authentication",
  "keys": {
    "KINDE_CLIENT_ID": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/",
      "description": "Kinde states no sensitivity for either half of the pair, so neither is treated as public. These names come from Kinde's own starter kit rather than from a page listing variables, because there is no such page."
    },
    "KINDE_CLIENT_SECRET": {
      "required": true,
      "sensitivity": "secret",
      "obtain": "https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/",
      "description": "The other half, for a backend flow."
    },
    "KINDE_ISSUER_URL": {
      "required": true,
      "sensitivity": "config",
      "obtain": "https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/",
      "description": "Your Kinde subdomain. An address."
    },
    "KINDE_SITE_URL": {
      "required": true,
      "sensitivity": "config",
      "obtain": "https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/",
      "description": "Your own application's address."
    },
    "KINDE_POST_LOGIN_REDIRECT_URL": {
      "required": false,
      "sensitivity": "config",
      "obtain": "https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/",
      "description": "Where a member lands after signing in."
    },
    "KINDE_POST_LOGOUT_REDIRECT_URL": {
      "required": false,
      "sensitivity": "config",
      "obtain": "https://docs.kinde.com/developer-tools/sdks/backend/nextjs-sdk/",
      "description": "Where a member lands after signing out."
    }
  }
}
