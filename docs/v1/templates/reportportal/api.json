{
  "name": "reportportal/api",
  "version": 1,
  "title": "ReportPortal — reporting",
  "keys": {
    "REPORTPORTAL_ENDPOINT": {
      "required": true,
      "sensitivity": "config",
      "pattern": "^https://\\S+$",
